{{- includeTemplate (joinPath .chezmoi.workingTree "home/.chezmoitemplates/validate-host") . -}}
{{- define "config-validate-temporals" -}}
  {{- if typeIs "time.Time" . -}}
    {{- if has .Location.String (list "date-local" "time-local" "datetime-local") -}}
      {{- fail "native init does not support local date/time/datetime; config is unchanged" -}}
    {{- end -}}
  {{- else if or (kindIs "map" .) (kindIs "slice" .) (kindIs "array" .) -}}
    {{- range . -}}{{- template "config-validate-temporals" . -}}{{- end -}}
  {{- end -}}
{{- end -}}
{{- /* Preserve local backend/data settings; only the update contract is owned. */ -}}
{{- $config := fromToml (replace "\r\n" "\n" (include .chezmoi.configFile)) -}}
{{- template "config-validate-temporals" $config -}}
{{- /* Native config keys are case-insensitive; do not leave duplicate aliases. */ -}}
{{- range $canonical := list "sourceDir" "destDir" "persistentState" "mode" "git" "update" "data" -}}
  {{- $found := false -}}
  {{- range $key, $value := $config -}}
    {{- if eq (lower $key) (lower $canonical) -}}
      {{- if $found -}}{{- fail "duplicate case-insensitive native config key" -}}{{- end -}}
      {{- $found = true -}}
      {{- if ne $key $canonical -}}
        {{- $config = deleteValueAtPath $key $config -}}
        {{- $config = setValueAtPath (list $canonical) $value $config -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $config = setValueAtPath (list "sourceDir") .chezmoi.workingTree $config -}}
{{- $config = setValueAtPath (list "destDir") .chezmoi.destDir $config -}}
{{- /* Plain native commands share the login updater's state database. */ -}}
{{- $config = setValueAtPath (list "persistentState") (printf "%s/.local/state/chezmoi/chezmoi.boltdb" .chezmoi.destDir) $config -}}
{{- $config = setValueAtPath (list "mode") "file" $config -}}
{{- $owned := dict "git" (dict "autoAdd" false "autoCommit" false "autoPush" false)
    "update" (dict "command" "git" "args" (list "-c" "rebase.autoStash=false" "-c" "merge.autoStash=false" "pull" "--ff-only" "--no-rebase" "--no-autostash" "--no-recurse-submodules") "recurseSubmodules" false) -}}
{{- range $table, $settings := $owned -}}
  {{- range $name, $value := $settings -}}
    {{- range $key, $_ := (get $config $table | default dict) -}}
      {{- if eq (lower $key) (lower $name) -}}
        {{- $config = deleteValueAtPath (printf "%s.%s" $table $key) $config -}}
      {{- end -}}
    {{- end -}}
    {{- $config = setValueAtPath (list $table $name) $value $config -}}
  {{- end -}}
{{- end -}}
{{- $config = setValueAtPath (list "data" "host") .host $config -}}
{{- toToml $config -}}
