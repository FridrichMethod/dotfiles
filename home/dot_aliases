#!/bin/sh

# tar alias
alias targz='tar -czvf'
alias untargz='tar -xzvf'

# nvim alias
if command -v nvim >/dev/null 2>&1; then
    alias vi='nvim'
fi

# ssh for terminal
alias ssh='TERM=xterm-256color ssh'

# Renewable stanford.edu Kerberos ticket for GSSAPI ssh (Sherlock, Marlowe);
# starts one background krenew (kstart) when installed
alias kstanford='kinit -l 25h -r 7d zyli2002@stanford.edu && { ! command -v krenew >/dev/null 2>&1 || pgrep -u "$USER" -x krenew >/dev/null || krenew -K 60 -b; }'

# Install or update the payload repos now, in the foreground:
# sync-payloads [kit] [pymol] [skills] (default: all); sync-skills is
# sync-payloads skills. Like the login dispatch in ~/.profile, they run the
# hook of the source checkout ~/.config/chezmoi/chezmoi.toml names (its
# sourceDir, validated by that checkout's lib/chezmoi-guard.sh) and refuse a
# config it refuses; a home without the config has no source, so they refuse
# there and name the --now line to run from its checkout.
# shellcheck source=/dev/null
_dotfiles_sync_payloads() (
    if [ ! -e "$HOME/.config/chezmoi/chezmoi.toml" ] && [ ! -L "$HOME/.config/chezmoi/chezmoi.toml" ]; then
        printf '%s\n' '[dotfiles] [error] Payload update needs ~/.config/chezmoi/chezmoi.toml; without it run sh CHECKOUT/scripts/payload-update.sh --now [ITEM...] instead.' >&2
        exit 1
    fi
    # Read only the first top-level sourceDir line, to locate that checkout's
    # guard, outside the command substitution: Bash 3.2 (macOS) cannot parse a
    # case statement inside one.
    _df_root=''
    if [ -f "$HOME/.config/chezmoi/chezmoi.toml" ] && [ ! -L "$HOME/.config/chezmoi/chezmoi.toml" ]; then
        while IFS= read -r _df_line || [ -n "$_df_line" ]; do
            case ${_df_line#"${_df_line%%[![:blank:]]*}"} in '['*) break ;; esac
            case $_df_line in
                'sourceDir = "/'*'"')
                    _df_root=${_df_line#'sourceDir = "'}
                    _df_root=${_df_root%'"'}
                    break
                    ;;
            esac
        done <"$HOME/.config/chezmoi/chezmoi.toml"
    fi
    if ! _df_root=$(
        [ -n "$_df_root" ] && [ -r "$_df_root/lib/chezmoi-guard.sh" ] || exit 1
        . "$_df_root/lib/chezmoi-guard.sh"
        dotfiles_chezmoi_source "$HOME"
    ); then
        printf '%s\n' '[dotfiles] [error] ~/.config/chezmoi/chezmoi.toml does not name this home and a dotfiles checkout; payload update refused.' >&2
        exit 1
    fi
    sh "$_df_root/scripts/payload-update.sh" --now "$@"
)
alias sync-payloads='_dotfiles_sync_payloads'
alias sync-skills='_dotfiles_sync_payloads skills'

# Load host-specific alias additions (if any)
if [ -r "$HOME/.config/sh/.aliases" ]; then
    . "$HOME/.config/sh/.aliases"
fi
