[credential]
	helper = /usr/local/bin/git-credential-manager
	credentialStore = gpg
[credential "https://dev.azure.com"]
	useHttpPath = true
[credential "https://github.com"]
	username = FridrichMethod
[credential "https://github.com"]
	helper =
	helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential
[credential "https://huggingface.co"]
	provider = generic
[safe]
	# Only the shared repositories another account owns here; a wildcard would
	# also trust a .git planted in /tmp or the group-writable data trees.
	# git 2.43 takes exact paths only (a trailing /* needs 2.46).
	directory = /apps/AF_Cluster
	directory = /apps/DynamicBind
	directory = /apps/boltz
	directory = /home/linuxbrew/.linuxbrew/Homebrew
