# Git for Windows enables core.autocrlf in its system config, so a plain
# clone there would rewrite every working-tree file to CRLF. chezmoi deploys
# these files byte for byte into $HOME, where POSIX tools read them, so pin LF
# and keep checkouts byte-identical on every platform.
* text=auto eol=lf

# Windows-native files already stored with CRLF in the index. -text disables
# EOL conversion outright, so `git add --renormalize` leaves their bytes
# alone; they still diff as text.
home/dot_wslconfig -text
home/mount.vbs -text

# Encrypted source is opaque; preserve the verified ciphertext bytes.
home/private_dot_secrets/*.age -text
