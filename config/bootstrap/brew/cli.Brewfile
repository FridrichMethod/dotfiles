# CLI tier: tools the aliases, previews and workflows use (S2-brew-bundle).
# pinned 2026-10-10: formula names verified on formulae.brew.sh.
# The tldr formula is the C client (tldr-c-client), whose -C/--color takes no
# argument (the fzf-tab previews try `--color always`, then -C). Homebrew will
# not install it while the tlrc or tealdeer formula is installed
# (conflicts_with: all three install `tldr`), so S2-brew-bundle reads this
# line and stops first with an uninstall block.
# conflicts: tldr tlrc tealdeer
brew "ripgrep"
brew "git-delta"
brew "tldr"
brew "chafa"
brew "jq"
brew "neovim"
brew "aria2"
brew "uv"
brew "gh"
