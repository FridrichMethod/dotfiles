# CLI tier: tools the aliases, previews and workflows use (S2-brew-bundle).
# pinned 2026-10-09: formula names verified on formulae.brew.sh.
# tlrc provides `tldr`; Homebrew will not install it while the tldr or
# tealdeer formula is installed (conflicts_with: both install `tldr`), so
# S2-brew-bundle reads this line and stops first with an uninstall block.
# conflicts: tlrc tldr tealdeer
brew "ripgrep"
brew "git-delta"
brew "tlrc"
brew "chafa"
brew "jq"
brew "neovim"
brew "aria2"
brew "uv"
brew "gh"
