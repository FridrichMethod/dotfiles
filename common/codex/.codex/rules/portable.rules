# Cross-host guardrails. Host-generated approvals remain in default.rules.
# A prompt decision is more restrictive than a matching host-local allow rule,
# so one machine cannot silently grant these capabilities to every host.

prefix_rule(
    pattern = [
        "git",
        [
            "add",
            "commit",
            "push",
            "pull",
            "clone",
            "ls-remote",
            "reset",
            "restore",
            "checkout",
            "clean",
        ],
    ],
    decision = "prompt",
    justification = "Mutating or networked Git operations require review.",
    match = [
        "git add README.md",
        "git commit -m update",
        "git push origin main",
        "git clone https://example.com/repo.git",
        "git reset --hard HEAD~1",
    ],
    not_match = [
        "git status --short",
        "git diff",
        "git log -1",
    ],
)

prefix_rule(
    pattern = [["curl", "wget"]],
    decision = "prompt",
    justification = "General-purpose network clients can write or exfiltrate data.",
    match = [
        "curl -LsS https://example.com",
        "wget https://example.com/archive.tar.gz",
    ],
    not_match = ["git status"],
)

prefix_rule(
    pattern = [["ssh", "scp", "rsync"]],
    decision = "prompt",
    justification = "Remote-shell and transfer commands can change external systems.",
    match = [
        "ssh lab-ubuntu hostname",
        "scp report.txt lab-ubuntu:/tmp/report.txt",
        "rsync -a results/ lab-ubuntu:/tmp/results/",
    ],
    not_match = ["ls -la"],
)

prefix_rule(
    pattern = [["rm", "rmdir", "mv"]],
    decision = "prompt",
    justification = "Deletion and moves can be destructive outside the workspace.",
    match = [
        "rm -rf build",
        "rmdir empty-directory",
        "mv source.txt /tmp/source.txt",
    ],
    not_match = ["cp source.txt destination.txt"],
)

prefix_rule(
    pattern = [["source", "."]],
    decision = "prompt",
    justification = "Sourcing a file executes its contents in the active shell.",
    match = [
        "source .venv/bin/activate",
        ". .venv/bin/activate",
    ],
    not_match = ["ls .venv/bin/activate"],
)

prefix_rule(
    pattern = [
        [
            "bash",
            "/bin/bash",
            "/usr/bin/bash",
            "sh",
            "/bin/sh",
            "/usr/bin/sh",
            "zsh",
            "/bin/zsh",
            "/usr/bin/zsh",
        ],
        ["-c", "-lc"],
    ],
    decision = "prompt",
    justification = "Opaque shell programs require review when they cannot be split safely.",
    match = [
        "bash -lc 'echo $HOME'",
        "/usr/bin/zsh -lc 'for file in *; do echo $file; done'",
    ],
    not_match = ["bash --version"],
)

prefix_rule(
    pattern = [["python", "python3"], "-c"],
    decision = "prompt",
    justification = "Inline Python can execute arbitrary code.",
    match = [
        "python -c 'print(1)'",
        "python3 -c 'from pathlib import Path; print(Path.cwd())'",
    ],
    not_match = ["python --version"],
)

prefix_rule(
    pattern = ["npx"],
    decision = "prompt",
    justification = "npx can download and execute arbitrary packages.",
    match = ["npx prettier --check ."],
    not_match = ["npm --version"],
)

prefix_rule(
    pattern = [["uv", "conda", "mamba"], "run"],
    decision = "prompt",
    justification = "Environment runners can execute arbitrary project code.",
    match = [
        "uv run pytest",
        "conda run -n research python analysis.py",
        "mamba run -n research pytest",
    ],
    not_match = ["conda env list"],
)

prefix_rule(
    pattern = [["pip", "pip3"], "install"],
    decision = "prompt",
    justification = "Package installation executes untrusted build and setup code.",
    match = [
        "pip install package",
        "pip3 install package",
    ],
    not_match = ["pip --version"],
)

prefix_rule(
    pattern = ["uv", "pip", "install"],
    decision = "prompt",
    justification = "Package installation executes untrusted build and setup code.",
    match = ["uv pip install package"],
    not_match = ["uv pip list"],
)

prefix_rule(
    pattern = [["conda", "mamba"], "install"],
    decision = "prompt",
    justification = "Environment mutation and package installation require review.",
    match = [
        "conda install numpy",
        "mamba install numpy",
    ],
    not_match = ["conda env list"],
)

prefix_rule(
    pattern = [["npm", "pnpm"], "install"],
    decision = "prompt",
    justification = "Package installation can execute lifecycle scripts.",
    match = [
        "npm install package",
        "pnpm install package",
    ],
    not_match = ["npm --version"],
)

prefix_rule(
    pattern = ["yarn", "add"],
    decision = "prompt",
    justification = "Package installation can execute lifecycle scripts.",
    match = ["yarn add package"],
    not_match = ["yarn --version"],
)

prefix_rule(
    pattern = ["brew", "install"],
    decision = "prompt",
    justification = "System package installation mutates the host.",
    match = ["brew install package"],
    not_match = ["brew list"],
)

prefix_rule(
    pattern = ["sudo"],
    decision = "prompt",
    justification = "Privilege escalation always requires review.",
    match = ["sudo apt-get update"],
    not_match = ["id"],
)

prefix_rule(
    pattern = ["gh", "api"],
    decision = "prompt",
    justification = "gh api can perform writes as well as reads.",
    match = ["gh api repos/owner/repo -X PATCH -f name=new-name"],
    not_match = ["gh search code query"],
)

prefix_rule(
    pattern = ["gh", "pr", ["create", "merge"]],
    decision = "prompt",
    justification = "Creating or merging a pull request changes remote state.",
    match = [
        "gh pr create --fill",
        "gh pr merge 42 --squash",
    ],
    not_match = ["gh pr view 42"],
)

prefix_rule(
    pattern = ["gh", "issue", "create"],
    decision = "prompt",
    justification = "Creating an issue changes remote state.",
    match = ["gh issue create --title bug --body details"],
    not_match = ["gh issue view 42"],
)

prefix_rule(
    pattern = ["gh", "release", "create"],
    decision = "prompt",
    justification = "Publishing a release changes remote state.",
    match = ["gh release create v1.0.0"],
    not_match = ["gh release view v1.0.0"],
)
