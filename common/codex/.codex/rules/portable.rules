# Cross-host guardrails. Host-generated approvals remain in default.rules.
# Prompt only for directly destructive, history-rewriting, or privileged
# commands; routine execution belongs to the sandbox and host-local approvals.

prefix_rule(
    pattern = [
        "git",
        [
            "reset",
            "clean",
        ],
    ],
    decision = "prompt",
    justification = "Destructive Git operations can irreversibly discard uncommitted work.",
    match = [
        "git reset --hard HEAD~1",
        "git clean -fd",
    ],
    not_match = [
        "git status --short",
        "git diff",
        "git log -1",
    ],
)

prefix_rule(
    pattern = [["rm", "rmdir", "mv", "shred", "truncate", "dd", "mkfs"]],
    decision = "prompt",
    justification = "Deletion, overwrite, and filesystem-destructive commands require review.",
    match = [
        "rm -rf build",
        "rmdir empty-directory",
        "mv source.txt /tmp/source.txt",
        "shred secret.txt",
        "truncate -s 0 results.csv",
        "dd if=image.raw of=device.img",
        "mkfs /dev/example",
    ],
    not_match = ["cp source.txt destination.txt"],
)

prefix_rule(
    pattern = [["sudo", "su", "doas"]],
    decision = "prompt",
    justification = "Privilege escalation always requires review.",
    match = [
        "sudo apt-get update",
        "su root",
        "doas pkg_add package",
    ],
    not_match = ["id"],
)
