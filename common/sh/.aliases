#!/bin/sh

# tar alias
alias targz='tar -czvf'
alias untargz='tar -xzvf'

# nvim alias
alias vi='nvim'

# ssh for terminal
alias ssh='TERM=xterm-256color ssh'

# Renewable stanford.edu Kerberos ticket for GSSAPI ssh (Sherlock, Marlowe);
# starts one background krenew (kstart) when installed
alias kstanford='kinit -l 25h -r 7d zyli2002@stanford.edu && { ! command -v krenew >/dev/null 2>&1 || pgrep -u "$USER" -x krenew >/dev/null || krenew -K 60 -b; }'

# Install or update the payload repos now, in the foreground, whatever their
# refresh intervals: sync-payloads [kit] [pymol] [skills] (default: all);
# sync-skills is sync-payloads skills
alias sync-payloads='sh "${DOTFILES_DIR:-$HOME/dotfiles}/scripts/payload-update.sh" --now'
alias sync-skills='sh "${DOTFILES_DIR:-$HOME/dotfiles}/scripts/payload-update.sh" --now skills'

# Load host-specific alias additions (if any)
if [ -r "$HOME/.config/sh/.aliases" ]; then
    . "$HOME/.config/sh/.aliases"
fi
