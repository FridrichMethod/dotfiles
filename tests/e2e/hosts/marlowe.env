# tests/e2e/hosts/marlowe.env: the marlowe row of the end-to-end bootstrap
# matrix: an Ubuntu image with Lmod, no sudo, the overlay's own SCRATCH, and
# the H2-alloc block stood in by E2E_ALLOC_ENV. Plain KEY=value lines;
# $HOME, $USER and $SCRATCH in single quotes are expanded by inside.sh. See
# lab-ubuntu.env for who reads which key.
E2E_IMAGE=dotfiles-e2e/marlowe
E2E_DOCKERFILE=ubuntu-lmod.Dockerfile
E2E_BUILD_ARGS='E2E_USER=zyli2002 E2E_HOME=/users/zyli2002'
E2E_PLATFORM_FLAG=linux/amd64
E2E_USER=zyli2002
E2E_HOME=/users/zyli2002
E2E_CONTAINER_ENV=
E2E_NATIVE_ONLY=
E2E_FLOW=unix
E2E_PROFILE=hpc
E2E_SETUP_HOST=marlowe
E2E_DOCTOR_ARGS='--host marlowe'
E2E_SUDO=no
E2E_ALLOC_ENV='SLURM_JOB_ID=424242 CONDA_PKGS_DIRS=$SCRATCH/.cache/conda/pkgs/$USER'
E2E_LOGIN_ZSH='$HOME/micromamba/envs/login/bin/zsh'
E2E_NEGATIVE='hpc-no-lmod alloc-first'
E2E_PACKAGES=
E2E_PKG_INSTALL=
E2E_SNAPSHOT_PRUNE=
