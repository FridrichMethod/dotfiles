# tests/e2e/hosts/sherlock.env: the sherlock row of the end-to-end bootstrap
# matrix: a Rocky 9 image with Lmod, no sudo, a fake site profile that
# exports SCRATCH, and the H2-alloc block stood in by E2E_ALLOC_ENV. Plain
# KEY=value lines; $HOME, $USER and $SCRATCH in single quotes are expanded
# by inside.sh. See lab-ubuntu.env for who reads which key.
E2E_IMAGE=dotfiles-e2e/sherlock
E2E_DOCKERFILE=rocky-lmod.Dockerfile
E2E_BUILD_ARGS='E2E_USER=zyli2002 E2E_HOME=/home/users/zyli2002'
E2E_PLATFORM_FLAG=linux/amd64
E2E_USER=zyli2002
E2E_HOME=/home/users/zyli2002
E2E_CONTAINER_ENV=
E2E_NATIVE_ONLY=
E2E_FLOW=unix
E2E_PROFILE=hpc
E2E_SETUP_HOST=sherlock
E2E_DOCTOR_ARGS='--host sherlock'
E2E_SUDO=no
E2E_ALLOC_ENV='SLURM_JOB_ID=424242 CONDA_PKGS_DIRS=$SCRATCH/.cache/conda/pkgs'
E2E_LOGIN_ZSH='$HOME/micromamba/envs/login/bin/zsh'
E2E_NEGATIVE='hpc-no-lmod alloc-first'
E2E_PACKAGES=
E2E_PKG_INSTALL=
E2E_SNAPSHOT_PRUNE=
