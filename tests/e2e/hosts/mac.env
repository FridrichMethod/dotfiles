# tests/e2e/hosts/mac.env: the mac row of the end-to-end bootstrap matrix.
# No image: tests/e2e/run.sh runs inside.sh natively on the macos runner
# (E2E_NATIVE=1, Darwin only), as the runner user in its real home. The
# workflow installs the wrappers in /usr/local/bin before the run, the one
# directory macOS's path_helper keeps ahead of /usr/bin in a login shell;
# inside.sh's own copy in $E2E_OUT/bin serves its non-login steps. sudo is
# passwordless there and writes no sudo.log, so the audits cover
# wrappers.log only. The home snapshots
# leave out the runner's own trees, which the bootstrap never touches:
# $HOME/work (the checkouts) and $HOME/Library, the Actions agent under
# $HOME/runners (its _diag logs are appended throughout the job, so a
# snapshot that watched it would fail every no-write step) and the
# preinstalled $HOME/hostedtoolcache (never written, but ~10^5 entries per
# traversal). env.txt records the expanded list. Plain KEY=value lines; see
# lab-ubuntu.env for who reads which key.
E2E_IMAGE=
E2E_DOCKERFILE=
E2E_BUILD_ARGS=
E2E_PLATFORM_FLAG=
E2E_USER=runner
E2E_HOME=/Users/runner
E2E_CONTAINER_ENV=
E2E_NATIVE_ONLY=1
E2E_FLOW=unix
E2E_PROFILE=macos
E2E_SETUP_HOST=mac
E2E_DOCTOR_ARGS='--host mac'
E2E_SUDO=yes
E2E_ALLOC_ENV=
E2E_LOGIN_ZSH=zsh
E2E_NEGATIVE='root-refused'
E2E_PACKAGES=
E2E_PKG_INSTALL=
E2E_SNAPSHOT_PRUNE='$HOME/work $HOME/Library $HOME/runners $HOME/hostedtoolcache'
