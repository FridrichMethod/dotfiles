# tests/e2e/hosts/mac.env: the mac row of the end-to-end bootstrap matrix.
# No image: tests/e2e/run.sh runs inside.sh natively on the macos runner
# (E2E_NATIVE=1, Darwin only), as the runner user in its real home, with the
# wrappers copied to a temp bin dir. sudo is passwordless there and writes
# no sudo.log, so the audits cover wrappers.log only. Plain KEY=value lines;
# see lab-ubuntu.env for who reads which key.
E2E_IMAGE=
E2E_DOCKERFILE=
E2E_BUILD_ARGS=
E2E_PLATFORM_FLAG=
E2E_USER=runner
E2E_HOME=/Users/runner
E2E_CONTAINER_ENV=
E2E_NATIVE_ONLY=1
E2E_FLOW=unix
E2E_PROFILE=macos
E2E_SETUP_HOST=mac
E2E_DOCTOR_ARGS='--host mac'
E2E_SUDO=yes
E2E_ALLOC_ENV=
E2E_LOGIN_ZSH=zsh
E2E_NEGATIVE='root-refused'
E2E_PACKAGES=
E2E_PKG_INSTALL=
E2E_SNAPSHOT_PRUNE='$HOME/work $HOME/Library'
