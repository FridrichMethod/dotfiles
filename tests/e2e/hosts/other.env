# tests/e2e/hosts/other.env: the "other Linux" row of the end-to-end
# bootstrap matrix: Fedora, no overlay, the X-other-linux steps done by hand
# (docs/bootstrap.md "Other Linux"). Plain KEY=value lines; see
# lab-ubuntu.env for who reads which key.
#
# E2E_PACKAGES names Fedora 44 packages (checked with dnf info in a fedora:44
# container on 2026-10-10): tldr is tealdeer, fd is fd-find, delta is
# git-delta, nvim is neovim, col is util-linux, man is man-db, the
# en_US.UTF-8 locale is glibc-langpack-en. "nodejs" is only a virtual
# provide there (dnf info fails), so the concrete nodejs22 package is named;
# it meets the node floor in config/bootstrap/tools.tsv (22.0).
E2E_IMAGE=dotfiles-e2e/other
E2E_DOCKERFILE=fedora.Dockerfile
E2E_BUILD_ARGS='E2E_USER=fridrichmethod E2E_HOME=/home/fridrichmethod'
E2E_PLATFORM_FLAG=
E2E_USER=fridrichmethod
E2E_HOME=/home/fridrichmethod
E2E_CONTAINER_ENV=
E2E_NATIVE_ONLY=
E2E_FLOW=other
E2E_PROFILE=other
E2E_SETUP_HOST=
E2E_DOCTOR_ARGS='--platform other'
E2E_SUDO=yes
E2E_ALLOC_ENV=
E2E_LOGIN_ZSH=zsh
E2E_NEGATIVE='root-refused common-only'
E2E_PACKAGES='git zsh curl rsync tar file tmux man-db util-linux python3 stow fzf zoxide eza fd-find bat git-lfs ripgrep git-delta tealdeer chafa jq neovim aria2 uv gh nodejs22 glibc-langpack-en'
E2E_PKG_INSTALL='sudo dnf install -y'
E2E_SNAPSHOT_PRUNE=
