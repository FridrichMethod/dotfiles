# tests/e2e/hosts/lab-ubuntu.env: the lab-ubuntu row of the end-to-end
# bootstrap matrix. Plain KEY=value lines: tests/e2e/run.sh sources it for the
# image keys, tests/e2e/inside.sh for the flow keys. A key already exported in
# inside.sh's environment wins over this file (the unit test's seam).
E2E_IMAGE=dotfiles-e2e/lab-ubuntu
E2E_DOCKERFILE=ubuntu.Dockerfile
E2E_BUILD_ARGS='E2E_USER=fridrichmethod E2E_HOME=/home/fridrichmethod'
E2E_PLATFORM_FLAG=
E2E_USER=fridrichmethod
E2E_HOME=/home/fridrichmethod
E2E_CONTAINER_ENV=
E2E_NATIVE_ONLY=
E2E_FLOW=unix
E2E_PROFILE=debian
E2E_SETUP_HOST=lab-ubuntu
E2E_DOCTOR_ARGS='--host lab-ubuntu'
E2E_SUDO=yes
E2E_ALLOC_ENV=
E2E_LOGIN_ZSH=zsh
E2E_NEGATIVE='wsl-refused root-refused'
E2E_PACKAGES=
E2E_PKG_INSTALL=
E2E_SNAPSHOT_PRUNE=
