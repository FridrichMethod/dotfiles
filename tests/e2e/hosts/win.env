# tests/e2e/hosts/win.env: the win row of the end-to-end bootstrap matrix.
# Native Windows is driven by tests/e2e/run.ps1; tests/e2e/run.sh prints a
# pointer to it and inside.sh refuses the host (both exit 2). The flow keys
# are therefore empty; the user and home are the windows-2025 runner's.
E2E_IMAGE=
E2E_DOCKERFILE=
E2E_BUILD_ARGS=
E2E_PLATFORM_FLAG=
E2E_USER=runneradmin
E2E_HOME=C:/Users/runneradmin
E2E_CONTAINER_ENV=
E2E_NATIVE_ONLY=1
E2E_FLOW=
E2E_PROFILE=windows
E2E_SETUP_HOST=win
E2E_DOCTOR_ARGS=
E2E_SUDO=no
E2E_ALLOC_ENV=
E2E_LOGIN_ZSH=
E2E_NEGATIVE=
E2E_PACKAGES=
E2E_PKG_INSTALL=
E2E_SNAPSHOT_PRUNE=
