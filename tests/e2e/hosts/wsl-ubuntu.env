# tests/e2e/hosts/wsl-ubuntu.env: the wsl-ubuntu row of the end-to-end
# bootstrap matrix: the lab image again, told it is WSL through
# WSL_DISTRO_NAME (lib/bootstrap/platform.sh bootstrap_is_wsl). Plain
# KEY=value lines; see lab-ubuntu.env for who reads which key.
E2E_IMAGE=dotfiles-e2e/lab-ubuntu
E2E_DOCKERFILE=ubuntu.Dockerfile
E2E_BUILD_ARGS='E2E_USER=fridrichmethod E2E_HOME=/home/fridrichmethod'
E2E_PLATFORM_FLAG=
E2E_USER=fridrichmethod
E2E_HOME=/home/fridrichmethod
E2E_CONTAINER_ENV='WSL_DISTRO_NAME=Ubuntu'
E2E_NATIVE_ONLY=
E2E_FLOW=unix
E2E_PROFILE=debian
E2E_SETUP_HOST=wsl-ubuntu
E2E_DOCTOR_ARGS='--host wsl-ubuntu'
E2E_SUDO=yes
E2E_ALLOC_ENV=
E2E_LOGIN_ZSH=zsh
E2E_NEGATIVE='lab-refused-in-wsl root-refused'
E2E_PACKAGES=
E2E_PKG_INSTALL=
E2E_SNAPSHOT_PRUNE=
