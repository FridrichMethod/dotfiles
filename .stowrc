--target=~

# Never link what git ignores: each .gitignore pattern with no slash but a
# trailing one, as a whole path component with everything below it
# (tests/test_stow_ignores.py).
# Stow 2.4 splits this file like a shell, dropping a lone backslash, and 2.3
# splits it on spaces: a character class such as [.] keeps a metacharacter
# literal for both, and for stow-all.ps1.
# OS metadata
--ignore=(^|/)([.]DS_Store[^/]?|[.]_[^/]*|[.]AppleDouble|[.]LSOverride|Icon[^/]|[.]Spotlight-V100|[.]Trashes|[.]fseventsd|[.]TemporaryItems|[.]VolumeIcon[.]icns|[.]apdisk|Desktop[.]ini|Thumbs[.]db|ehthumbs[.]db|[$]RECYCLE[.]BIN|[^/]*[.]stackdump)(/.*)?$
# Editor and IDE files
--ignore=(^|/)([^/]*~|[^/]*[.](sw[pomn]|tmp|bak|orig|rej|patch|iml|code-workspace|sublime-project|sublime-workspace|log)|[.][#][^/]*|[#][^/]*[#]|[.]idea|[.]vscode|[.]history)(/.*)?$
# Language caches, dependencies, build and test output, Cursor
--ignore=(^|/)(__pycache__|[^/]*[.]py[cod]|[.]pytest_cache|[.]mypy_cache|[.]ruff_cache|[.]tox|[.]venv|[.]cache|node_modules|dist|build|coverage|[.]coverage|coverage[.]xml|[.]cursor)(/.*)?$

# common/codex/.codex/config.toml is a portable merge source, not a symlink
# target. Codex Desktop owns the mutable regular file at ~/.codex/config.toml.
--ignore=(^|/)\.codex/config\.toml$

# Cross-host Codex rules are materialized next to the mutable default.rules.
--ignore=(^|/)\.codex/rules/portable\.rules$

# common/claude/.claude/settings.json is a portable merge source, not a symlink
# target. Claude Code owns the mutable regular file at ~/.claude/settings.json.
--ignore=(^|/)\.claude/settings\.json$

# <host>/fcitx5/.config/fcitx5/profile is a portable baseline, not a symlink
# target. fcitx5 owns the mutable regular file at ~/.config/fcitx5/profile.
--ignore=(^|/)\.config/fcitx5/profile$

--ignore=(^|/)[.]Trash(-[0-9]+)?(/.*)?$

# The pre-move coding-agent-kit checkout that a fast-forward leaves in the
# codex package on a host where the submodule was checked out (.gitignore keeps
# it out of git status); without this line Stow would link its whole tree.
# common/coding-agent-kit/.stow-local-ignore ignores the current checkout.
# Drop this line only after no host has the leftover (docs/coding-agent-kit.md).
--ignore=^coding-agent-kit(/|$)

# Retired Sherlock checkout may remain without its package ignore file.
--ignore=^sherlock-kit(/|$)
