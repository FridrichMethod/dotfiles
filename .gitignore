# Stow also ignores each pattern here with no slash but a trailing one, which
# git matches at any depth: add every new one to .stowrc too
# (tests/test_stow_ignores.py).

# OS metadata
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
Icon?
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.apdisk
Desktop.ini
Thumbs.db
ehthumbs.db
$RECYCLE.BIN/
*.stackdump

# Editor/IDE files
*~
*.swp
*.swo
*.swn
*.swm
*.tmp
*.bak
*.orig
*.rej
*.patch
.#*
\#*#
.idea/
*.iml
.vscode/
*.code-workspace
*.sublime-project
*.sublime-workspace
.history/
*.log

# Language/runtime caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.venv/
/.venv-sync/
.cache/

# Package/dependency directories
node_modules/

# Build/test artifacts
dist/
build/
coverage/
.coverage
coverage.xml

# Cursor (local-only AI assistant config)
.cursor/

# End-to-end bootstrap runs (tests/e2e/run.sh)
/tests/e2e/out/

# The coding-agent-kit checkout that a fast-forward across the kit's move to
# common/coding-agent-kit leaves on a host where the submodule was checked out
# (git cannot remove a submodule checkout that holds files). Keep this line:
# without it a host that pulls the move stops updating (docs/coding-agent-kit.md).
/common/codex/coding-agent-kit/

# Retired submodule checkout retained on existing hosts.
/common/sherlock-kit/sherlock-kit/
