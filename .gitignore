# Stow also ignores each pattern here with no slash but a trailing one, which
# git matches at any depth: add every new one to .stowrc too
# (tests/test_stow_ignores.py).

# OS metadata
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
Icon?
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.apdisk
Desktop.ini
Thumbs.db
ehthumbs.db
$RECYCLE.BIN/
*.stackdump

# Editor/IDE files
*~
*.swp
*.swo
*.swn
*.swm
*.tmp
*.bak
*.orig
*.rej
*.patch
.#*
\#*#
.idea/
*.iml
.vscode/
*.code-workspace
*.sublime-project
*.sublime-workspace
.history/
*.log

# Language/runtime caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.venv/
/.venv-sync/
.cache/

# Package/dependency directories
node_modules/

# Build/test artifacts
dist/
build/
coverage/
.coverage
coverage.xml

# Cursor (local-only AI assistant config)
.cursor/

# End-to-end bootstrap runs (tests/e2e/run.sh)
/tests/e2e/out/

# Retired submodule checkouts that a fast-forward leaves on a host where they
# were checked out (git cannot remove a submodule checkout that holds files):
# coding-agent-kit from before its move to its own package, then both
# submodules from before the payload repos became installed ones. Keep these
# lines: without them such a host stops updating, at "Checkout changed during
# update" and then "Local changes" (docs/payloads.md, Migration). The doctor
# prints the rm that removes each.
/common/codex/coding-agent-kit/
/common/coding-agent-kit/coding-agent-kit/
/common/pymol/PyMOLScripts/

# Retired submodule checkout retained on existing hosts.
/common/sherlock-kit/sherlock-kit/
