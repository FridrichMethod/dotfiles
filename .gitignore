# Files git never tracks in this checkout. chezmoi reads no .gitignore:
# home/.chezmoiignore repeats every unanchored pattern that does not start
# with a dot, and chezmoi skips dot-named sources, so nothing listed here
# deploys from home/ (a test pins it). A leftover in home/.chezmoidata/ is
# read as data instead and stops every chezmoi run until it is removed.

# OS metadata
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
Icon?
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.apdisk
Desktop.ini
Thumbs.db
ehthumbs.db
$RECYCLE.BIN/
*.stackdump

# Editor/IDE files
.worktrees/
*~
*.swp
*.swo
*.swn
*.swm
*.tmp
*.bak
*.orig
*.rej
*.patch
.#*
\#*#
.idea/
*.iml
.vscode/
*.code-workspace
*.sublime-project
*.sublime-workspace
.history/
*.log

# Language/runtime caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.venv/
.cache/

# Package/dependency directories
node_modules/

# Build/test artifacts
dist/
build/
coverage/
.coverage
coverage.xml

# Cursor (local-only AI assistant config)
.cursor/

# Machine-local Claude Code permission answers
/.claude/settings.local.json

# End-to-end bootstrap runs (tests/e2e/run.sh)
/tests/e2e/out/
